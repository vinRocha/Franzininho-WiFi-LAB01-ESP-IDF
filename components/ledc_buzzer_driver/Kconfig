menu "LEDC Buzzer Driver"

    config LEDC_BUZZER_GPIO
        int "LEDC Buzzer GPIO"
        default 17

    config LEDC_BUZZER_FREQ_DEFAULT
        int "LEDC Buzzer default frequency (Hz)"
        default 523

    config LEDC_BUZZER_TASK_PRIORITY
        int "LEDC Buzzer Task Priority"
        default 3

    config LEDC_BUZZER_TASK_STACK_SIZE
        int "LEDC Buzzer Task Stack Size in words"
        default 2048

endmenu